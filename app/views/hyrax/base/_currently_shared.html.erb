<% permission_service = Hyrax::EditPermissionsService.build_service_object_from(form: f, ability: current_ability) %>

<h2 class="h3 mt-4"><%= t('.currently_sharing') %></h2>

<div class="overflow-auto">
<table class="table table-bordered">
  <caption class="sr-only"><%= t('.currently_sharing') %></caption>
  <thead>
    <tr>
      <th scope="col"><%= t('.table_title_user') %></th>
      <th scope="col"><%= t('.table_title_access') %></th>
      <th scope="col" class="text-center"><%= t('.table_title_action') %></th>
    </tr>
  </thead>
  <tbody>
  <tr id="file_permissions" data-next-index="<%= f.object.permissions.size %>">
    <td>
      <%= label_tag :owner_access, class: "col-form-label" do %>
        Depositor (<span id="file_owner" data-depositor="<%= permission_service.depositor %>"><%= link_to_profile permission_service.depositor %></span>)
      <% end %>
    </td>
    <td><%= Hyrax.config.owner_permission_levels.keys[0] %></td>
    <td></td>
  </tr>
  <%= f.fields_for :permissions do |permission_fields| %>
    <% permission_hash = permission_fields.object.to_hash %>
    <% permission_service.with_applicable_permission(permission_hash: permission_hash) do |permission| %>
    <% level = Hyrax.config.permission_levels.value?(permission.access) %>
    <% editable = level && permission.can_edit? %>
    <tr>
      <td>
        <%= permission_fields.label :agent_name, class: "col-form-label" do %>
          <%= user_display_name_and_key(permission.name) %>
          <%= permission.granted_by_html_hint %>
        <% end %>
      </td>
      <td>
        <% if editable %>
          <%= permission_fields.select :access, Hyrax.config.permission_levels, {}, class: 'form-control w-auto select_perm', 'aria-label': t('.table_title_access') %>
        <% else %>
          <%= Hyrax.config.permission_levels.key(permission.access) || permission.access.humanize %>
          <%# Locked grants are sent unchanged, so saving the agent's other rows keeps them %>
          <%= permission_fields.hidden_field :access, value: permission_hash[:access] if level %>
        <% end %>
        <% if level %>
          <%= permission_fields.hidden_field :type, value: permission_hash[:type] %>
          <%= permission_fields.hidden_field :name, value: permission_hash[:name] %>
        <% end %>
      </td>
      <td class="text-center">
        <% if editable %>
          <button class="btn close float-none remove_perm" data-index="<%= permission_fields.index %>" aria-label="<%= t('helpers.action.remove') %>">&times;</button>
        <% end %>
      </td>
    </tr>
    <% end %>
  <% end %>
  </tbody>
</table>
</div>
