<% # main container for facets/limits menu -%>
<% facets = capture do %>
  <%= render Blacklight::FacetComponent.with_collection(blacklight_config.facet_fields_in_group(nil), response: @response, component: Hyrax::DropdownFacetFieldComponent)%>
<% end %>

<% if facets.present? %>
  <div class="dashboard-filter-group" role="group" aria-labelledby="filter-works-label">
    <span class="list-filters-label" id="filter-works-label"><%= t("hyrax.dashboard.my.facet_label.works") %></span>
    <div class="dashboard-filter-group-items"><%= facets %></div>
  </div>
<% end %>
