<%= render 'catalog/did_you_mean' %>

<% filters = capture do %>
  <%= render 'facets' %>
  <%= render 'constraints' %>
<% end %>
<% if filters.present? %>
  <div class="list-filters"><%= filters %></div>
<% end %>

<div class="row">
  <div class="col-sm-5">
    <%= render 'hyrax/my/sort_and_per_page' %>
  </div>
  <div class="col-sm-7">
    <%= render 'search_form' %>
  </div>
</div>

<%= render 'batch_actions' %>
