<% schema_version = SolrDocument.find(f.object.id).schema_version if action_name == 'edit' %>
<% schema_version = Hyrax::FlexibleSchema.current_schema_id if action_name == 'new' %>
<% updating = (schema_version.to_f < @latest_schema_version.to_f) ? 'updating' : '' %>

<div class='schema-version-group'>
  <% if schema_version.present? %>
    <div class='schema-version text-center'>
      <span class="schema-version-label"><%= I18n.t("shared.schema_version.created_on_version", :default => "Created On Version") %></span>
      <span class="schema-version-number"><%= schema_version.to_f %></span>
    </div>
  <% end %>
  <div class='schema-version text-center <%= updating %>'>
    <span class="schema-version-label"><%= I18n.t("shared.schema_version.version_after_save", :default => "Version After Save") %></span>
    <span class="schema-version-number"><%= @latest_schema_version %></span>
  </div>
</div>
