<% property = Hyrax::Microdata.fetch("#{key}.property") %>
<% itemtype = Hyrax::Microdata.fetch("#{key}.type") %>
<% pairs = record.respond_to?(:value_label_pairs) ? record.value_label_pairs(key) : record.display_values_for(key).map { |value| [value, nil] } %>
<% pairs.each do |value, label| %>
  <% link = link_to_value_facet(value, label, "#{key}_sim") %>
  <% if itemtype %>
    <span itemprop="<%= property %>" itemscope itemtype="<%= itemtype %>">
      <span itemprop="<%= Hyrax::Microdata.fetch("#{key}.value", default: 'name') %>"><%= link %></span>
    </span>
  <% elsif property %>
    <span itemprop="<%= property %>"><%= link %></span>
  <% else %>
    <%= link %>
  <% end %>
  <br />
<% end %>
